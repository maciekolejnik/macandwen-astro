---
import type { PackingListDetail } from '../lib/db/packing-lists';
import PackingListItemRow from './PackingListItemRow.astro';
import PackingListOptionRow from './PackingListOptionRow.astro';
import { TITLE_MAX_LENGTH } from '../lib/packing-list-limits';

interface Props {
  /** Absent when creating; the form posts instead of patching. */
  list?: PackingListDetail;
}

const { list } = Astro.props;

const isEdit = Boolean(list);
// One blank row to write in, so an empty form is not a dead end.
const items = list?.items ?? [];
const options = list?.options ?? [];
---

<form
  id="packing-list-form"
  data-list-id={list?.id}
  method="post"
  action={isEdit ? `/api/packing-lists/${list!.id}` : '/api/packing-lists'}
  class="mt-8"
  novalidate
>
  <p
    id="form-error"
    role="alert"
    hidden
    class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
  >
  </p>

  <label class="block">
    <span class="text-sm font-medium text-stone-700">Title</span>
    <input
      id="list-title"
      name="title"
      type="text"
      required
      maxlength={TITLE_MAX_LENGTH}
      value={list?.title ?? ''}
      placeholder="Alpine day hike"
      class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2 text-stone-900 outline-none transition-colors focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
    />
  </label>

  <fieldset class="mt-8">
    <legend class="text-sm font-medium text-stone-700">Options</legend>
    <p class="mt-1 text-xs text-stone-500">
      Independent choices for a trip — "Cooking", "Wild camping". Tag items with
      the options they belong to; untagged items are always packed.
    </p>

    <ul id="option-rows" class="mt-3 space-y-2">
      {options.map((option) => (
        <PackingListOptionRow option={option} />
      ))}
    </ul>

    <!-- Cloned by the client script for every option added after load. -->
    <template id="option-row-template">
      <PackingListOptionRow />
    </template>

    <button
      type="button"
      id="add-option"
      class="mt-3 rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100"
    >
      Add option
    </button>
  </fieldset>

  <fieldset class="mt-8">
    <legend class="text-sm font-medium text-stone-700">Items</legend>

    <ul id="item-rows" class="mt-2 space-y-2">
      {items.map((item) => (
        <PackingListItemRow text={item.text} optionIds={item.optionIds} />
      ))}
    </ul>

    <!-- Cloned by the client script for every row added after load. -->
    <template id="item-row-template">
      <PackingListItemRow />
    </template>

    <button
      type="button"
      id="add-item"
      class="mt-3 rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100"
    >
      Add item
    </button>

    <p class="mt-2 text-xs text-stone-400">
      Press Enter to add an item below, Backspace in an empty one to remove it.
      Blank items are dropped.
    </p>
  </fieldset>

  <label class="mt-8 flex items-start gap-3">
    <input
      id="list-public"
      name="isPublic"
      type="checkbox"
      checked={list?.isPublic ?? false}
      class="mt-1 h-4 w-4 shrink-0 rounded border-stone-300 accent-emerald-600"
    />
    <span class="text-sm text-stone-700">
      <span class="font-medium">Share publicly</span>
      <span class="mt-0.5 block text-stone-500">
        Anyone can find and save a public list. Private lists are visible only
        to you.
      </span>
    </span>
  </label>

  <div class="mt-10 flex items-center gap-3">
    <button
      type="submit"
      id="save-list"
      class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-emerald-800 disabled:opacity-60"
    >
      {isEdit ? 'Save changes' : 'Create list'}
    </button>
    <a
      href={isEdit ? `/packing-lists/${list!.id}` : '/packing-lists'}
      class="rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100"
    >
      Cancel
    </a>

    {isEdit && (
      <button
        type="button"
        id="delete-list"
        class="ml-auto rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-700 transition-colors hover:bg-red-50 disabled:opacity-60"
      >
        Delete list
      </button>
    )}
  </div>
</form>

<script>
  import { MAX_OPTIONS } from '../lib/packing-list-limits';

  const form = document.getElementById('packing-list-form') as HTMLFormElement | null;
  const rows = document.getElementById('item-rows');
  const optionRows = document.getElementById('option-rows');
  const addItem = document.getElementById('add-item');
  const addOption = document.getElementById('add-option') as HTMLButtonElement | null;
  const title = document.getElementById('list-title') as HTMLInputElement | null;
  const isPublic = document.getElementById('list-public') as HTMLInputElement | null;
  const save = document.getElementById('save-list') as HTMLButtonElement | null;
  const remove = document.getElementById('delete-list') as HTMLButtonElement | null;
  const errorBox = document.getElementById('form-error');
  const template = document.getElementById(
    'item-row-template',
  ) as HTMLTemplateElement | null;
  const optionTemplate = document.getElementById(
    'option-row-template',
  ) as HTMLTemplateElement | null;

  if (
    form &&
    rows &&
    optionRows &&
    addItem &&
    addOption &&
    title &&
    isPublic &&
    save &&
    template &&
    optionTemplate
  ) {
    const listId = form.dataset.listId;

    const showError = (message: string) => {
      if (!errorBox) return;
      errorBox.textContent = message;
      errorBox.hidden = false;
      errorBox.scrollIntoView({ block: 'nearest' });
    };

    const clearError = () => {
      if (errorBox) errorBox.hidden = true;
    };

    const itemRows = () => [...rows.querySelectorAll<HTMLLIElement>('[data-item-row]')];
    const allOptionRows = () => [
      ...optionRows.querySelectorAll<HTMLLIElement>('[data-option-row]'),
    ];

    /**
     * An option an item can be tagged with. A row added in the browser has no
     * id yet, so it gets a temporary one: the tags refer to it while the form
     * is open, and the server swaps in a real id when the list is saved.
     */
    const options = () =>
      allOptionRows().map((row) => {
        if (!row.dataset.optionId) row.dataset.optionId = crypto.randomUUID();

        return {
          id: row.dataset.optionId,
          label: row.querySelector<HTMLInputElement>('[data-option-input]')!.value,
          defaultOn: row.querySelector<HTMLInputElement>('[data-option-default]')!
            .checked,
        };
      });

    const tagsOf = (row: HTMLLIElement) =>
      (row.dataset.optionIds ?? '').split(' ').filter(Boolean);

    /**
     * Rebuilds every item's tag chips from the options as they now stand.
     *
     * Rebuilt rather than patched: at eight options and a few hundred items it
     * costs nothing, and one direction of copying cannot fall out of step the
     * way reconciling two lists can.
     */
    const paintTags = () => {
      const current = options().filter((option) => option.label.trim());
      const known = new Set(current.map((option) => option.id));

      for (const row of itemRows()) {
        const tags = tagsOf(row).filter((id) => known.has(id));
        row.dataset.optionIds = tags.join(' ');

        const container = row.querySelector<HTMLElement>('[data-item-tags]');
        if (!container) continue;

        container.hidden = current.length === 0;
        container.replaceChildren();

        for (const option of current) {
          const on = tags.includes(option.id);
          const chip = document.createElement('button');

          chip.type = 'button';
          chip.dataset.tag = option.id;
          chip.textContent = option.label.trim();
          chip.setAttribute('aria-pressed', on ? 'true' : 'false');
          chip.className = on
            ? 'rounded-full border border-emerald-600 bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-800'
            : 'rounded-full border border-stone-300 bg-white px-2.5 py-0.5 text-xs font-medium text-stone-500 hover:bg-stone-100';

          container.appendChild(chip);
        }
      }

      addOption.disabled = allOptionRows().length >= MAX_OPTIONS;
    };

    /** The move buttons at the ends have nowhere to go, so they are disabled. */
    const paint = () => {
      const all = itemRows();

      all.forEach((row, index) => {
        row.querySelector<HTMLButtonElement>('[data-move-up]')!.disabled = index === 0;
        row.querySelector<HTMLButtonElement>('[data-move-down]')!.disabled =
          index === all.length - 1;
      });

      paintTags();
    };

    /** Adds a blank row, after `after` when given and at the end otherwise. */
    const addRow = (focus = true, after?: HTMLLIElement) => {
      // Cloned from the <template>, so a new row is the same markup the server
      // renders for an existing one — there is no second copy to keep in step.
      const row = template.content.firstElementChild!.cloneNode(
        true,
      ) as HTMLLIElement;

      if (after?.nextElementSibling) {
        rows.insertBefore(row, after.nextElementSibling);
      } else {
        rows.appendChild(row);
      }

      paint();
      if (focus) row.querySelector<HTMLInputElement>('[data-item-input]')!.focus();

      return row;
    };

    if (itemRows().length === 0) addRow(false);
    paint();

    addItem.addEventListener('click', () => addRow());

    addOption.addEventListener('click', () => {
      if (allOptionRows().length >= MAX_OPTIONS) return;

      const row = optionTemplate.content.firstElementChild!.cloneNode(
        true,
      ) as HTMLLIElement;

      optionRows.appendChild(row);
      paintTags();
      row.querySelector<HTMLInputElement>('[data-option-input]')!.focus();
    });

    // Renaming an option must reach the chips, which carry its label.
    optionRows.addEventListener('input', paintTags);
    optionRows.addEventListener('change', paintTags);

    optionRows.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('button');
      const row = (event.target as HTMLElement).closest<HTMLLIElement>(
        '[data-option-row]',
      );
      if (!button?.hasAttribute('data-remove-option') || !row) return;

      const label =
        row.querySelector<HTMLInputElement>('[data-option-input]')!.value.trim();
      const tagged = itemRows().filter((item) =>
        tagsOf(item).includes(row.dataset.optionId ?? ''),
      ).length;

      // Removing an option untags items, which the button does not say.
      if (tagged > 0) {
        const confirmed = window.confirm(
          `Remove "${label}"? ${tagged} item${tagged === 1 ? '' : 's'} tagged with it will go back to being always packed.`,
        );
        if (!confirmed) return;
      }

      row.remove();
      paintTags();
    });

    // One listener for every chip, including those rebuilt a moment ago.
    rows.addEventListener('click', (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-tag]',
      );
      const row = (event.target as HTMLElement).closest<HTMLLIElement>(
        '[data-item-row]',
      );
      if (!chip || !row) return;

      const tags = new Set(tagsOf(row));
      if (tags.has(chip.dataset.tag!)) tags.delete(chip.dataset.tag!);
      else tags.add(chip.dataset.tag!);

      row.dataset.optionIds = [...tags].join(' ');
      paintTags();
    });

    // One listener on the container, so rows added later need no wiring.
    rows.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('button');
      const row = (event.target as HTMLElement).closest<HTMLLIElement>('[data-item-row]');
      if (!button || !row) return;

      if (button.hasAttribute('data-remove-item')) {
        row.remove();
        if (itemRows().length === 0) addRow(false);
      } else if (button.hasAttribute('data-move-up')) {
        const previous = row.previousElementSibling;
        if (previous) rows.insertBefore(row, previous);
      } else if (button.hasAttribute('data-move-down')) {
        const next = row.nextElementSibling;
        // Moving the next row up is the same swap, and needs no reference to
        // whatever follows it.
        if (next) rows.insertBefore(next, row);
      }

      paint();
    });

    /*
     * Enter inserts a row directly below the current one, the way a notes app
     * does, so remembering something halfway down a list means typing it where
     * it belongs rather than appending and then moving it up. It would
     * otherwise submit a half-written list.
     *
     * Backspace in an empty row deletes it, which is the matching way out of a
     * row added by mistake — and the reason Enter can afford to be eager.
     */
    rows.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement;
      if (!target.matches('[data-item-input]')) return;

      const input = target as HTMLInputElement;
      const row = input.closest<HTMLLIElement>('[data-item-row]');
      if (!row) return;

      if (event.key === 'Enter') {
        event.preventDefault();

        // From a blank row, move on rather than stacking up more blank rows.
        if (!input.value.trim()) {
          const next = row.nextElementSibling?.querySelector<HTMLInputElement>(
            '[data-item-input]',
          );
          next?.focus();
          return;
        }

        addRow(true, row);
        return;
      }

      if (
        event.key === 'Backspace' &&
        input.value === '' &&
        itemRows().length > 1
      ) {
        event.preventDefault();

        const previous = row.previousElementSibling?.querySelector<HTMLInputElement>(
          '[data-item-input]',
        );
        const next = row.nextElementSibling?.querySelector<HTMLInputElement>(
          '[data-item-input]',
        );

        row.remove();
        paint();

        const focused = previous ?? next;
        focused?.focus();
        // Land at the end of the text, where typing carries on naturally.
        focused?.setSelectionRange(focused.value.length, focused.value.length);
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearError();

      const items = itemRows()
        .map((row) => ({
          text: row.querySelector<HTMLInputElement>('[data-item-input]')!.value.trim(),
          optionIds: tagsOf(row),
        }))
        .filter((item) => item.text.length > 0);

      const submittedOptions = options()
        .map((option) => ({ ...option, label: option.label.trim() }))
        .filter((option) => option.label.length > 0);

      if (!title.value.trim()) {
        showError('A packing list needs a title');
        title.focus();
        return;
      }

      const labels = new Set<string>();
      const duplicate = submittedOptions.find((option) => {
        const key = option.label.toLocaleLowerCase();
        if (labels.has(key)) return true;
        labels.add(key);
        return false;
      });

      if (duplicate) {
        showError(`Two options are both called "${duplicate.label}"`);
        return;
      }

      save.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: listId ? 'PATCH' : 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            title: title.value,
            isPublic: isPublic.checked,
            options: submittedOptions,
            items,
          }),
        });

        const payload = (await response.json().catch(() => null)) as
          | { id?: string; error?: string }
          | null;

        if (!response.ok) {
          save.disabled = false;
          showError(payload?.error ?? 'Something went wrong. Please try again.');
          return;
        }

        window.location.href = `/packing-lists/${listId ?? payload?.id ?? ''}`;
      } catch {
        save.disabled = false;
        showError('Could not reach the server. Please try again.');
      }
    });

    remove?.addEventListener('click', async () => {
      if (!listId) return;

      const confirmed = window.confirm(
        'Delete this packing list? This cannot be undone.',
      );
      if (!confirmed) return;

      clearError();
      remove.disabled = true;

      try {
        const response = await fetch(`/api/packing-lists/${listId}`, {
          method: 'DELETE',
        });

        if (!response.ok) {
          remove.disabled = false;
          const payload = (await response.json().catch(() => null)) as
            | { error?: string }
            | null;
          showError(payload?.error ?? 'Could not delete this list.');
          return;
        }

        window.location.href = '/packing-lists';
      } catch {
        remove.disabled = false;
        showError('Could not reach the server. Please try again.');
      }
    });
  }
</script>
