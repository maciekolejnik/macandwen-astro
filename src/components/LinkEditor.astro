---
import type { PlaceLink, PlaceSummary } from '../lib/db/places';
import { NOTE_MAX_LENGTH, RELATIONS, RELATION_NAMES } from '../lib/places-constants';

interface Props {
  placeId: string;
  links: PlaceLink[];
  /** Everything the viewer can see, so they can only link to what exists for
   * them; the API checks the same thing again. */
  candidates: PlaceSummary[];
  /** Only the owner may link, so everybody else gets the plain list. */
  editable: boolean;
}

const { placeId, links, candidates, editable } = Astro.props;

const others = candidates.filter((candidate) => candidate.id !== placeId);
---

<section class="mt-8" data-link-editor={editable ? '' : null} data-place-id={placeId}>
  <h2 class="text-lg font-semibold text-stone-900">Nearby and related</h2>

  <!-- Said out loud because everything else on this page waits for Save, and
       a control that does not should admit it. -->
  {
    editable && (
      <p class="mt-1 text-xs text-stone-500">Links save as you add them.</p>
    )
  }

  <p
    data-link-error
    role="alert"
    hidden
    class="mt-3 rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-700"
  >
  </p>

  {
    links.length > 0 && (
      <ul class="mt-3 divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white">
        {links.map((link) => (
          <li class="flex items-center gap-4 px-5 py-3" data-link-id={link.id}>
            <span class="text-xs uppercase tracking-wide text-stone-400">
              {link.label}
            </span>
            <a
              href={`/places/${link.other.slug}`}
              class="ml-auto text-sm font-medium text-emerald-700 hover:underline"
            >
              {link.other.name}
            </a>
            {editable && (
              <button
                type="button"
                data-remove-link
                aria-label={`Unlink ${link.other.name}`}
                class="shrink-0 text-xs text-stone-400 transition-colors hover:text-red-600"
              >
                Remove
              </button>
            )}
          </li>
        ))}
      </ul>
    )
  }

  {
    links.length === 0 && editable && (
      <p class="mt-3 text-sm text-stone-500">
        Nothing linked yet — a car park, a hut, the walk that starts here.
      </p>
    )
  }

  {
    editable && others.length > 0 && (
      <div class="mt-4 flex flex-wrap items-end gap-2">
        <label class="block">
          <span class="text-xs uppercase tracking-wide text-stone-400">This one</span>
          <select
            data-link-relation
            class="mt-1 rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
          >
            {RELATION_NAMES.map((relation) => (
              <option value={relation}>{RELATIONS[relation].label.toLowerCase()}</option>
            ))}
          </select>
        </label>

        <label class="block flex-1">
          <span class="text-xs uppercase tracking-wide text-stone-400">That one</span>
          <select
            data-link-target
            class="mt-1 w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
          >
            {others.map((other) => (
              <option value={other.id}>{other.name}</option>
            ))}
          </select>
        </label>

        <input
          type="text"
          maxlength={NOTE_MAX_LENGTH}
          placeholder="Note (optional)"
          data-link-note
          class="rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
        />

        <button
          type="button"
          data-add-link
          class="rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm text-stone-700 transition-colors hover:bg-stone-100 disabled:opacity-50"
        >
          Link
        </button>
      </div>
    )
  }
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-link-editor]');

  if (root) {
    const placeId = root.dataset.placeId!;
    const errorBox = root.querySelector<HTMLElement>('[data-link-error]')!;
    const relation = root.querySelector('[data-link-relation]') as HTMLSelectElement | null;
    const target = root.querySelector('[data-link-target]') as HTMLSelectElement | null;
    const note = root.querySelector<HTMLInputElement>('[data-link-note]');
    const add = root.querySelector<HTMLButtonElement>('[data-add-link]');

    const showError = (message: string) => {
      errorBox.textContent = message;
      errorBox.hidden = false;
    };

    /** Reloading rather than patching, for the same reason as visits: the
     * label of a link depends on which end you read it from, and the server
     * already knows how to work that out. */
    const send = async (method: string, body: unknown, button: HTMLButtonElement) => {
      errorBox.hidden = true;
      button.disabled = true;

      try {
        const response = await fetch(`/api/places/${placeId}/links`, {
          method,
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });

        if (!response.ok) {
          button.disabled = false;
          const payload = (await response.json().catch(() => null)) as
            | { error?: string }
            | null;
          showError(payload?.error ?? 'That did not work. Please try again.');
          return;
        }

        window.location.reload();
      } catch {
        button.disabled = false;
        showError('Could not reach the server. Please try again.');
      }
    };

    add?.addEventListener('click', () => {
      if (!relation || !target || !target.value) return;

      void send(
        'POST',
        {
          toEntryId: target.value,
          relation: relation.value,
          note: note?.value ?? null,
        },
        add,
      );
    });

    root.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-remove-link]',
      );
      if (!button) return;

      const item = button.closest<HTMLLIElement>('[data-link-id]');
      if (!item) return;

      void send('DELETE', { linkId: item.dataset.linkId }, button);
    });
  }
</script>
