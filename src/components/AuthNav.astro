---
import AuthNavLink from './AuthNavLink.astro';

interface Props {
  transparentHeader?: boolean;
}

const { transparentHeader = false } = Astro.props;

// Rendered as a server island, so this runs in the Worker on every page view
// with the visitor's cookies attached, even when the surrounding page is
// prerendered. `Astro.locals` is populated by `src/middleware.ts`.
const user = Astro.locals.user;
const firstName = user?.name?.split(' ')[0];
---

{user
  ? <AuthNavLink href="/account" label={firstName || 'Account'} transparentHeader={transparentHeader} />
  : <AuthNavLink href="/login" label="Sign in" transparentHeader={transparentHeader} />}
