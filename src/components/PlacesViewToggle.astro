---
/**
 * The switch between the two views of one query. It carries the query string
 * across, so that when filters arrive a filtered list becomes a filtered map
 * with no further work — that is the whole of what the toggle has to do for
 * them.
 */
interface Props {
  active: 'list' | 'map';
}

const { active } = Astro.props;
const search = Astro.url.search;

const base =
  'px-3 py-1.5 text-sm font-medium transition-colors first:rounded-l-lg last:rounded-r-lg';
const on = 'bg-emerald-600 text-white';
const off = 'bg-white text-stone-700 hover:bg-stone-100';
---

<nav class="inline-flex overflow-hidden rounded-lg border border-stone-300" aria-label="View">
  <a
    href={`/places${search}`}
    class:list={[base, active === 'list' ? on : off]}
    aria-current={active === 'list' ? 'page' : undefined}
  >
    List
  </a>
  <a
    href={`/places/map${search}`}
    class:list={[base, active === 'map' ? on : off]}
    aria-current={active === 'map' ? 'page' : undefined}
  >
    Map
  </a>
</nav>
