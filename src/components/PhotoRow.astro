---
import { CAPTION_MAX_LENGTH, URL_MAX_LENGTH } from '../lib/places-constants';

interface Props {
  url?: string;
  caption?: string | null;
  /** What this photo already measured, so editing an entry does not load
   * every one of its photos again to learn what it already knows. */
  width?: number | null;
  height?: number | null;
}

const { url = '', caption = '', width = null, height = null } = Astro.props;
---

<!--
  One photo of the editor. Rendered by the server for an existing photo and put
  inside a <template> for the client script to clone, so the markup exists once
  rather than twice in two languages.

  Order matters here in a way it does not for a packing list: the first photo is
  the entry's picture on the list and in a shared link, so the move buttons are
  the point rather than a nicety.
-->
<li
  class="rounded-lg border border-stone-200 bg-white p-3"
  data-photo-row
  data-photo-width={width ?? undefined}
  data-photo-height={height ?? undefined}
>
  <div class="flex items-center gap-2">
    <input
      type="url"
      value={url}
      maxlength={URL_MAX_LENGTH}
      placeholder="https://media.macandwen.com/…"
      data-photo-url
      class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 outline-none transition-colors focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
    />
    <button
      type="button"
      data-move-up
      aria-label="Move photo up"
      class="shrink-0 rounded-lg border border-stone-300 bg-white px-2 py-2 text-stone-500 transition-colors hover:bg-stone-100 disabled:opacity-30"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
    </button>
    <button
      type="button"
      data-move-down
      aria-label="Move photo down"
      class="shrink-0 rounded-lg border border-stone-300 bg-white px-2 py-2 text-stone-500 transition-colors hover:bg-stone-100 disabled:opacity-30"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </button>
    <button
      type="button"
      data-remove-photo
      aria-label="Remove photo"
      class="shrink-0 rounded-lg border border-stone-300 bg-white px-2 py-2 text-stone-500 transition-colors hover:bg-red-50 hover:text-red-600"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
  </div>

  <div class="mt-2 flex items-center gap-2">
    <input
      type="text"
      value={caption ?? ''}
      maxlength={CAPTION_MAX_LENGTH}
      placeholder="Caption (optional)"
      data-photo-caption
      class="w-full rounded-lg border border-stone-200 bg-stone-50 px-3 py-1.5 text-xs text-stone-700 outline-none transition-colors focus:border-emerald-500 focus:bg-white"
    />
    <p class="shrink-0 text-xs text-stone-400" data-photo-position></p>
  </div>
</li>
