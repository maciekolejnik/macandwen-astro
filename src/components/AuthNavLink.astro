---
interface Props {
  href: string;
  label: string;
  transparentHeader?: boolean;
}

const { href, label, transparentHeader = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    'transition-colors',
    transparentHeader ? 'text-white/90 hover:text-white' : 'text-stone-600 hover:text-emerald-700',
  ]}
>
  {label}
</a>
