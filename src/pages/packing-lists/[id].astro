---
import Layout from '../../layouts/Layout.astro';
import { getById } from '../../lib/db/packing-lists';

// Reads the session, so it cannot be prerendered.
export const prerender = false;

const user = Astro.locals.user;
const list = await getById(Astro.params.id!, user?.id);

// `getById` already answers `null` for a private list the visitor cannot see,
// so a missing list and a forbidden one are the same page — nothing here can
// confirm which ids exist.
if (!list) {
  Astro.response.status = 404;
}

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

{list ? (
  <Layout title={list.title} description={`A packing list: ${list.title}.`}>
    <div class="mx-auto max-w-2xl px-4 py-12">
      <a href="/packing-lists" class="text-sm text-stone-500 dark:text-stone-400 transition-colors hover:text-emerald-700 dark:hover:text-emerald-400">
        &larr; All packing lists
      </a>

      <div class="mt-4 flex items-start justify-between gap-4">
        <h1 class="text-3xl font-bold text-stone-900 dark:text-stone-100">{list.title}</h1>

        <div class="mt-1 flex shrink-0 items-center gap-3">
          {list.isOwn && !list.isPublic && (
            <span class="rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-600 dark:bg-stone-800 dark:text-stone-300">
              Private
            </span>
          )}
          {user && list.isPublic && !list.isOwn && (
            <button
              type="button"
              data-save-list={list.id}
              aria-pressed={list.isFavourite ? 'true' : 'false'}
              aria-label={list.isFavourite ? 'Unsave this list' : 'Save this list'}
              class:list={[
                'flex items-center gap-1.5 rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-sm font-medium transition-colors dark:border-stone-700 dark:bg-stone-900',
                list.isFavourite
                  ? 'text-emerald-700 hover:bg-emerald-50 dark:text-emerald-400 dark:hover:bg-emerald-950'
                  : 'text-stone-400 hover:bg-stone-100 hover:text-stone-600 dark:text-stone-500 dark:hover:bg-stone-800 dark:hover:text-stone-300',
              ]}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill={list.isFavourite ? 'currentColor' : 'none'}
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
              </svg>
              <span data-save-label>{list.isFavourite ? 'Saved' : 'Save'}</span>
            </button>
          )}
          {list.isOwn && (
            <a
              href={`/packing-lists/${list.id}/edit`}
              class="rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100 dark:border-stone-700 dark:bg-stone-900 dark:text-stone-200 dark:hover:bg-stone-800"
            >
              Edit
            </a>
          )}
        </div>
      </div>

      <p class="mt-2 text-sm text-stone-500 dark:text-stone-400">
        {list.isOwn ? 'Yours' : `By ${list.ownerName}`} &middot; updated {formatDate(list.updatedAt)}
        {list.isPublic && (
          <span data-save-count={list.id}>
            {' '}&middot; <span data-save-count-value>{list.favouriteCount}</span> saves
          </span>
        )}
      </p>

      {list.items.length > 0 ? (
        <>
          <p
            id="packed-count"
            class="mt-8 text-sm font-medium text-stone-500 dark:text-stone-400"
            data-total={list.items.length}
            hidden
          >
          </p>

          <ul
            id="packing-items"
            data-list-id={list.id}
            class="mt-3 divide-y divide-stone-200 dark:divide-stone-800 overflow-hidden rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900"
          >
            {list.items.map((item) => (
              <li>
                <label class="flex cursor-pointer items-center gap-3 px-5 py-3 transition-colors hover:bg-stone-50 dark:hover:bg-stone-800">
                  <input
                    type="checkbox"
                    value={item.id}
                    class="h-4 w-4 shrink-0 rounded border-stone-300 dark:border-stone-700 text-emerald-600 accent-emerald-600"
                  />
                  <span class="text-stone-800 dark:text-stone-200 transition-colors">{item.text}</span>
                </label>
              </li>
            ))}
          </ul>

          <button
            id="reset-ticks"
            type="button"
            hidden
            class="mt-4 rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-xs font-medium text-stone-600 transition-colors hover:bg-stone-100 dark:border-stone-700 dark:bg-stone-900 dark:text-stone-300 dark:hover:bg-stone-800"
          >
            Clear ticks
          </button>

          <p class="mt-3 text-xs text-stone-400 dark:text-stone-500">
            Ticks are kept on this device for a week after you last open this
            list. They are not stored on your account.
          </p>
        </>
      ) : (
        <p class="mt-8 rounded-xl border border-dashed border-stone-300 bg-white dark:border-stone-700 dark:bg-stone-900 p-6 text-sm text-stone-500 dark:text-stone-400">
          This list has no items yet.
        </p>
      )}
    </div>
  </Layout>
) : (
  <Layout title="Packing list not found">
    <div class="mx-auto max-w-2xl px-4 py-20 text-center">
      <h1 class="text-3xl font-bold text-stone-900 dark:text-stone-100">Packing list not found</h1>
      <p class="mt-3 text-stone-600 dark:text-stone-300">
        It may have been deleted, or it may be private.
      </p>
      <a
        href="/packing-lists"
        class="mt-8 inline-block rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100 dark:border-stone-700 dark:bg-stone-900 dark:text-stone-200 dark:hover:bg-stone-800"
      >
        All packing lists
      </a>
    </div>
  </Layout>
)}

<script>
  import {
    loadTicks,
    pruneExpiredTicks,
    saveTicks,
  } from '../../lib/packing-ticks';
  import { wireSaveButtons } from '../../lib/save-button';

  wireSaveButtons();

  const list = document.getElementById('packing-items');
  const listId = list?.dataset.listId;
  const counter = document.getElementById('packed-count');
  const reset = document.getElementById('reset-ticks');

  if (list && listId && counter instanceof HTMLElement && reset) {
    const boxes = [
      ...list.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'),
    ];

    // Only ever removes entries, so it is safe to run on every page view.
    pruneExpiredTicks(localStorage);

    const ticked = loadTicks(
      localStorage,
      listId,
      boxes.map((box) => box.value),
    );

    const paint = () => {
      let packed = 0;

      for (const box of boxes) {
        const label = box.closest('label');
        label?.classList.toggle('text-stone-400', box.checked);
        label?.querySelector('span')?.classList.toggle('line-through', box.checked);
        if (box.checked) packed += 1;
      }

      counter.textContent = `${packed} of ${boxes.length} packed`;
      counter.hidden = false;
      reset.hidden = packed === 0;
    };

    for (const box of boxes) {
      box.checked = ticked.has(box.value);

      box.addEventListener('change', () => {
        if (box.checked) ticked.add(box.value);
        else ticked.delete(box.value);

        saveTicks(localStorage, listId, ticked);
        paint();
      });
    }

    reset.addEventListener('click', () => {
      ticked.clear();
      for (const box of boxes) box.checked = false;

      saveTicks(localStorage, listId, ticked);
      paint();
    });

    paint();
  }
</script>
