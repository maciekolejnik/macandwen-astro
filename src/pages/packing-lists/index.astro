---
import Layout from '../../layouts/Layout.astro';
import PackingListCard from '../../components/PackingListCard.astro';
import { loadIndex } from '../../lib/packing-lists-view';

// Reads the session, so it cannot be prerendered.
export const prerender = false;

const user = Astro.locals.user;
const { own, public: publicLists } = await loadIndex(user?.id);
---

<Layout
  title="Packing lists"
  description="Packing lists for hikes, trips and everything in between."
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold text-stone-900">Packing lists</h1>
    <p class="mt-2 max-w-prose text-stone-600">
      What to bring, worked out once so it need not be worked out again.
    </p>

    {user ? (
      <section class="mt-12">
        <h2 class="text-lg font-semibold text-stone-900">Your lists</h2>

        {own.length > 0 ? (
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {own.map((list) => <PackingListCard list={list} showOwner={false} />)}
          </div>
        ) : (
          <p class="mt-4 rounded-xl border border-dashed border-stone-300 bg-white p-6 text-sm text-stone-500">
            You have not made a packing list yet.
          </p>
        )}
      </section>
    ) : (
      <p class="mt-8 rounded-xl border border-stone-200 bg-white p-6 text-sm text-stone-600">
        <a href="/login?redirectTo=/packing-lists" class="font-medium text-emerald-700 hover:underline">
          Sign in
        </a>{' '}
        to keep your own packing lists.
      </p>
    )}

    <section class="mt-12">
      <h2 class="text-lg font-semibold text-stone-900">Public lists</h2>
      <p class="mt-1 text-sm text-stone-500">Most favourited first.</p>

      {publicLists.length > 0 ? (
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {publicLists.map((list) => <PackingListCard list={list} />)}
        </div>
      ) : (
        <p class="mt-4 rounded-xl border border-dashed border-stone-300 bg-white p-6 text-sm text-stone-500">
          Nobody has shared a packing list yet.
        </p>
      )}
    </section>
  </div>
</Layout>
