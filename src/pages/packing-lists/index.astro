---
import Layout from '../../layouts/Layout.astro';
import PackingListCard from '../../components/PackingListCard.astro';
import { applyFilters, loadIndex } from '../../lib/packing-lists-view';
import { parseFilters, type Section } from '../../lib/packing-lists-search';

// Reads the session, so it cannot be prerendered.
export const prerender = false;

const user = Astro.locals.user;
const filters = parseFilters(Astro.url.searchParams);
const view = await loadIndex(user?.id);

/*
 * Filtering happens here as well as in the browser, from the same module. A
 * link with a search in it therefore arrives already filtered, with no flash of
 * the full page, and the form still works with JavaScript switched off.
 */
const filtered = applyFilters(view, filters);
const sections = Object.fromEntries(
  filtered.sections.map((section) => [section.key, section]),
) as Record<Section, (typeof filtered.sections)[number]>;

const chips: { key: Section; label: string }[] = [
  { key: 'mine', label: 'Mine' },
  { key: 'saved', label: 'Saved' },
  { key: 'public', label: 'Public' },
];
---

<Layout
  title="Packing lists"
  description="Packing lists for hikes, trips and everything in between."
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-stone-900 dark:text-stone-100">Packing lists</h1>
        <p class="mt-2 max-w-prose text-stone-600 dark:text-stone-300">
          What to bring, worked out once so it need not be worked out again.
        </p>
      </div>

      {user && (
        <a
          href="/packing-lists/new"
          class="shrink-0 rounded-lg bg-emerald-700 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-500"
        >
          New list
        </a>
      )}
    </div>

    <!-- A real GET form, so filtering still works without JavaScript. -->
    <form
      id="packing-filters"
      method="get"
      action="/packing-lists"
      class="mt-8 flex flex-wrap items-center gap-3"
    >
      <label class="min-w-56 flex-1">
        <span class="sr-only">Search packing lists</span>
        <input
          type="search"
          name="q"
          value={filters.query}
          placeholder="Search titles and items"
          autocomplete="off"
          class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900 placeholder:text-stone-400 dark:border-stone-700 dark:bg-stone-900 dark:text-stone-100 dark:placeholder:text-stone-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
        />
      </label>

      {user && (
        <div class="flex items-center gap-2">
          {chips.map((chip) => (
            <label
              data-chip={chip.key}
              class:list={[
                'cursor-pointer rounded-full border px-3 py-1.5 text-sm font-medium transition-colors focus-within:ring-2 focus-within:ring-emerald-500 focus-within:ring-offset-2',
                filters.show.includes(chip.key)
                  ? 'border-emerald-600 bg-emerald-600 text-white dark:border-emerald-500 dark:bg-emerald-600'
                  : 'border-stone-300 bg-white text-stone-600 hover:bg-stone-100 dark:border-stone-700 dark:bg-stone-900 dark:text-stone-300 dark:hover:bg-stone-800',
              ]}
            >
              <input
                type="checkbox"
                name="show"
                value={chip.key}
                checked={filters.show.includes(chip.key)}
                class="sr-only"
              />
              {chip.label}
            </label>
          ))}
        </div>
      )}

      <noscript>
        <button
          type="submit"
          class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-medium text-white dark:bg-emerald-600"
        >
          Filter
        </button>
      </noscript>
    </form>

    {user ? (
      <div
        id="your-lists"
        hidden={!sections.mine.visible && !sections.saved.visible}
        class="mt-8 space-y-8 rounded-2xl border border-stone-200 bg-stone-100/60 dark:border-stone-800 dark:bg-stone-900/60 p-6"
      >
        <section data-section="mine" hidden={!sections.mine.visible}>
          <h2 class="text-lg font-semibold text-stone-900 dark:text-stone-100">Your lists</h2>

          {sections.mine.entries.length > 0 ? (
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {sections.mine.entries.map((entry) => (
                <PackingListCard
                  list={entry.list}
                  showOwner={false}
                  hidden={!entry.visible}
                />
              ))}
            </div>
          ) : (
            <p class="mt-3 text-sm text-stone-500 dark:text-stone-400">
              You have not made a packing list yet.{' '}
              <a href="/packing-lists/new" class="font-medium text-emerald-700 dark:text-emerald-400 hover:underline">
                Make your first one.
              </a>
            </p>
          )}
        </section>

        <section data-section="saved" hidden={!sections.saved.visible}>
          <h2 class="text-lg font-semibold text-stone-900 dark:text-stone-100">Saved lists</h2>

          {sections.saved.entries.length > 0 ? (
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              {sections.saved.entries.map((entry) => (
                <PackingListCard list={entry.list} canSave hidden={!entry.visible} />
              ))}
            </div>
          ) : (
            <p class="mt-3 text-sm text-stone-500 dark:text-stone-400">
              Lists you save from below are kept here.
            </p>
          )}
        </section>
      </div>
    ) : (
      <p class="mt-8 rounded-xl border border-stone-200 bg-white dark:border-stone-800 dark:bg-stone-900 p-6 text-sm text-stone-600 dark:text-stone-300">
        <a href="/login?redirectTo=/packing-lists" class="font-medium text-emerald-700 dark:text-emerald-400 hover:underline">
          Sign in
        </a>{' '}
        to keep your own packing lists and save other people's.
      </p>
    )}

    <section
      data-section="public"
      class="mt-12"
      hidden={!sections.public.visible}
    >
      <h2 class="text-lg font-semibold text-stone-900 dark:text-stone-100">
        {user ? 'More public lists' : 'Public lists'}
      </h2>
      <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">Most saved first.</p>

      {sections.public.entries.length > 0 ? (
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {sections.public.entries.map((entry) => (
            <PackingListCard
              list={entry.list}
              canSave={Boolean(user)}
              hidden={!entry.visible}
            />
          ))}
        </div>
      ) : (
        <p class="mt-4 rounded-xl border border-dashed border-stone-300 bg-white dark:border-stone-700 dark:bg-stone-900 p-6 text-sm text-stone-500 dark:text-stone-400">
          {user
            ? 'Nothing here you have not already got.'
            : 'Nobody has shared a packing list yet.'}
        </p>
      )}
    </section>

    <p
      id="no-matches"
      hidden={!filtered.empty}
      class="mt-8 rounded-xl border border-dashed border-stone-300 bg-white dark:border-stone-700 dark:bg-stone-900 p-6 text-sm text-stone-500 dark:text-stone-400"
    >
      Nothing matches that. Try fewer words, or a different filter.
    </p>
  </div>
</Layout>

<script>
  import { wireSaveButtons } from '../../lib/save-button';
  import { wireFilters } from '../../lib/packing-lists-filter';

  wireSaveButtons();
  wireFilters();
</script>
