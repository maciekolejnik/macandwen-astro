---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login?redirectTo=/account');
}
---

<Layout title="Account" description="Your Mac & Wen account.">
  <div class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-stone-900 mb-8">Your account</h1>

    <div class="flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-6">
      {user.image && (
        <img src={user.image} alt="" width="56" height="56" class="rounded-full" referrerpolicy="no-referrer" />
      )}
      <div>
        <p class="font-semibold text-stone-900">{user.name}</p>
        <p class="text-sm text-stone-500">{user.email}</p>
        {user.role === 'admin' && (
          <span class="mt-1 inline-block rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-800">
            Admin
          </span>
        )}
      </div>
    </div>

    <button
      id="signout"
      class="mt-8 rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100"
    >
      Sign out
    </button>
  </div>
</Layout>

<script>
  import { signOut } from '../lib/auth-client';

  document.getElementById('signout')?.addEventListener('click', async () => {
    await signOut();
    window.location.href = '/';
  });
</script>
