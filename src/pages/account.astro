---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login?redirectTo=/account');
}
---

<Layout title="Account" description="Your Mac & Wen account.">
  <div class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-stone-900 mb-8">Your account</h1>

    <div class="flex items-center gap-4 rounded-xl border border-stone-200 bg-white p-6">
      {user.image && (
        <img src={user.image} alt="" width="56" height="56" class="rounded-full" referrerpolicy="no-referrer" />
      )}
      <div>
        <p class="font-semibold text-stone-900">{user.name}</p>
        <p class="text-sm text-stone-500">{user.email}</p>
        {user.role === 'admin' && (
          <span class="mt-1 inline-block rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-800">
            Admin
          </span>
        )}
      </div>
    </div>

    <button
      id="signout"
      class="mt-8 rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100"
    >
      Sign out
    </button>

    <section class="mt-16 border-t border-stone-200 pt-8">
      <h2 class="text-lg font-semibold text-stone-900">Delete account</h2>
      <p class="mt-2 max-w-prose text-sm text-stone-600">
        Permanently removes your name, email, picture and the tokens Google
        issued, along with any lists attached to your account. This cannot be
        undone. See{' '}
        <a href="/privacy" class="text-emerald-700 hover:underline">privacy</a>{' '}
        for what is stored.
      </p>

      <p
        id="delete-error"
        role="alert"
        hidden
        class="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
      >
      </p>

      <button
        id="delete-account"
        class="mt-4 rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-700 transition-colors hover:bg-red-50 disabled:opacity-60"
      >
        Delete account
      </button>
    </section>
  </div>
</Layout>

<script>
  import { signOut, deleteUser } from '../lib/auth-client';

  document.getElementById('signout')?.addEventListener('click', async () => {
    await signOut();
    window.location.href = '/';
  });

  const button = document.getElementById('delete-account') as HTMLButtonElement | null;
  const errorBox = document.getElementById('delete-error');

  function showError(message: string) {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.hidden = false;
  }

  button?.addEventListener('click', async () => {
    const confirmed = window.confirm(
      'Permanently delete your account? This cannot be undone.',
    );
    if (!confirmed) return;

    button.disabled = true;
    if (errorBox) errorBox.hidden = true;

    const { error } = await deleteUser({ callbackURL: '/' });

    if (!error) {
      window.location.href = '/';
      return;
    }

    button.disabled = false;
    // Without a password to re-check, better-auth requires a session younger
    // than `freshAge`, so this is the expected path for a long-signed-in visitor.
    showError(
      error.status === 400
        ? 'For your security, please sign out and sign in again, then delete your account.'
        : 'Something went wrong deleting your account. Please try again.',
    );
  });
</script>
