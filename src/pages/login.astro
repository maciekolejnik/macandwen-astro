---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

if (Astro.locals.user) {
  return Astro.redirect('/account');
}

const error = Astro.url.searchParams.get('error');
const redirectTo = Astro.url.searchParams.get('redirectTo') ?? '/account';
---

<Layout title="Sign in" description="Sign in to Mac & Wen to manage your packing lists.">
  <div class="max-w-md mx-auto px-4 py-20">
    <h1 class="text-3xl font-bold text-stone-900 dark:text-stone-100 dark:text-stone-100 mb-2">Sign in</h1>
    <p class="text-stone-600 dark:text-stone-300 mb-8">
      Sign in with your Google account to create and manage your own packing lists.
    </p>

    {error && (
      <p class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300 dark:border-red-900 dark:bg-red-950 dark:text-red-300">
        Something went wrong signing you in. Please try again.
      </p>
    )}

    <button
      id="google-signin"
      data-redirect-to={redirectTo}
      class="w-full flex items-center justify-center gap-3 rounded-lg border border-stone-300 bg-white px-4 py-3 font-medium text-stone-800 transition-colors hover:bg-stone-100 dark:border-stone-700 dark:bg-stone-900 dark:text-stone-100 dark:hover:bg-stone-800 disabled:opacity-60"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.91c1.7-1.57 2.69-3.88 2.69-6.62z"/>
        <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.91-2.26c-.81.54-1.84.86-3.05.86-2.35 0-4.34-1.58-5.05-3.71H.96v2.33A9 9 0 0 0 9 18z"/>
        <path fill="#FBBC05" d="M3.95 10.71a5.4 5.4 0 0 1 0-3.42V4.96H.96a9 9 0 0 0 0 8.08l2.99-2.33z"/>
        <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .96 4.96l2.99 2.33C4.66 5.16 6.65 3.58 9 3.58z"/>
      </svg>
      Continue with Google
    </button>

    <p class="mt-6 text-sm text-stone-500 dark:text-stone-400">
      Signing in stores your name, email and profile picture so we can greet you
      and keep your lists. See <a href="/privacy" class="text-emerald-700 dark:text-emerald-400 hover:underline">privacy</a>,
      and delete your account at any time.
    </p>
  </div>
</Layout>

<script>
  import { signIn } from '../lib/auth-client';

  const button = document.getElementById('google-signin') as HTMLButtonElement | null;

  button?.addEventListener('click', async () => {
    button.disabled = true;
    const callbackURL = button.dataset.redirectTo || '/account';
    const { error } = await signIn.social({ provider: 'google', callbackURL });
    if (error) {
      button.disabled = false;
      window.location.href = '/login?error=1';
    }
  });
</script>
