---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => {
    const dateA = new Date(a.data.publishdate ?? a.data.date ?? '1970-01-01');
    const dateB = new Date(b.data.publishdate ?? b.data.date ?? '1970-01-01');
    return dateB.getTime() - dateA.getTime();
  })
  .slice(0, 12);
---

<Layout title="Home" description="Mac & Wen — travel, hiking, and adventure blog." transparentHeader>
  <!-- Hero -->
  <section class="relative h-[70vh] min-h-80 flex items-center justify-center overflow-hidden">
    <img
      src="https://media.macandwen.com/images/home/cover.jpeg"
      alt="Mac & Wen cover"
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/40"></div>
    <div class="relative z-10 text-center px-4">
      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-white mb-4 drop-shadow-lg">
        Travel. Hike. Explore.
      </h1>
      <p class="text-lg sm:text-xl text-white/80 max-w-xl mx-auto drop-shadow">
        Adventures from two people who can't stay in one place — hiking trails, city breaks, and everything in between.
      </p>
      <a
        href="/blog"
        class="inline-block mt-8 px-6 py-3 bg-white text-stone-900 text-sm font-semibold rounded-lg hover:bg-stone-100 dark:bg-stone-100 dark:hover:bg-white transition-colors shadow-lg"
      >
        Read the blog
      </a>
    </div>
  </section>

  <!-- Recent posts -->
  <section class="max-w-5xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-bold text-stone-900 dark:text-stone-100 mb-8">Recent posts</h2>
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-6">
      {posts.map(post => {
        const displayDate = post.data.publishdate ?? post.data.date;
        const thumb = post.data.small_image ?? post.data.featured_image;
        return (
          <a href={`/blog/${post.id}`} class="group block bg-white dark:bg-stone-900 rounded-xl overflow-hidden border border-stone-200 dark:border-stone-800 hover:border-emerald-400 dark:hover:border-emerald-500 transition-colors shadow-sm hover:shadow-md break-inside-avoid mb-6">
            <div class="overflow-hidden bg-stone-100 dark:bg-stone-800">
              <img
                src={thumb}
                alt={post.data.title}
                class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              {displayDate && (
                <p class="text-xs text-stone-400 dark:text-stone-500 mb-1">
                  {new Date(displayDate).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
                </p>
              )}
              <h3 class="font-semibold text-stone-900 dark:text-stone-100 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors leading-snug">
                {post.data.title}
              </h3>
              {post.data.summary && (
                <p class="mt-2 text-sm text-stone-500 dark:text-stone-400 line-clamp-2">{post.data.summary}</p>
              )}
            </div>
          </a>
        );
      })}
    </div>
    <div class="mt-10 text-center">
      <a href="/blog" class="text-sm font-semibold text-emerald-700 hover:text-emerald-800 dark:text-emerald-400 dark:hover:text-emerald-300 transition-colors">
        View all posts →
      </a>
    </div>
  </section>
</Layout>
