---
import Layout from '../../layouts/Layout.astro';
import PlaceForm from '../../components/PlaceForm.astro';
import { isAdmin } from '../../lib/db/places';

// Reads the session, so it cannot be prerendered.
export const prerender = false;

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login?redirectTo=/places/new');
}
---

<Layout title="Add a place" description="Add a place or something to do.">
  <div class="mx-auto max-w-2xl px-4 py-12">
    <a href="/places" class="text-sm text-stone-500 transition-colors hover:text-emerald-700">
      &larr; Places &amp; activities
    </a>

    <h1 class="mt-4 text-3xl font-bold text-stone-900">Add something</h1>

    <PlaceForm canPublish={isAdmin(user)} />
  </div>
</Layout>
