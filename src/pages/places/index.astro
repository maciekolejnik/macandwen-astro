---
import Layout from '../../layouts/Layout.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import { loadIndex } from '../../lib/places-view';

// Reads the session, so it cannot be prerendered.
export const prerender = false;

const user = Astro.locals.user;
const { own, browse } = await loadIndex(user);
---

<Layout
  title="Places & activities"
  description="Lakes, hikes, viewpoints and everything else worth going back to."
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <div>
      <h1 class="text-3xl font-bold text-stone-900">Places &amp; activities</h1>
      <p class="mt-2 max-w-prose text-stone-600">
        Somewhere to keep the lakes, hikes and viewpoints that would otherwise
        live in a phone's screenshots folder.
      </p>
    </div>

    {user ? (
      <section class="mt-8 rounded-2xl border border-stone-200 bg-stone-100/60 p-6">
        <h2 class="text-lg font-semibold text-stone-900">Yours</h2>

        {own.length > 0 ? (
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {own.map((place) => (
              <PlaceCard place={place} showOwner={false} />
            ))}
          </div>
        ) : (
          <p class="mt-3 text-sm text-stone-500">
            Anything you add is kept here, and stays private unless it is made
            public.
          </p>
        )}
      </section>
    ) : (
      <p class="mt-8 rounded-xl border border-stone-200 bg-white p-6 text-sm text-stone-600">
        <a
          href="/login?redirectTo=/places"
          class="font-medium text-emerald-700 hover:underline"
        >
          Sign in
        </a>{' '}
        to keep your own places and things to do.
      </p>
    )}

    <section class="mt-12">
      <h2 class="text-lg font-semibold text-stone-900">
        {user ? 'Shared with everyone' : 'Places & activities'}
      </h2>

      {browse.length > 0 ? (
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {browse.map((place) => (
            <PlaceCard place={place} />
          ))}
        </div>
      ) : (
        <p class="mt-4 rounded-xl border border-dashed border-stone-300 bg-white p-6 text-sm text-stone-500">
          Nothing has been shared publicly yet.
        </p>
      )}
    </section>
  </div>
</Layout>
