---
import Layout from '../../layouts/Layout.astro';
import { getBySlug } from '../../lib/db/places';
import {
  extentNote,
  factsFor,
  formatCoordinates,
  typeBadges,
} from '../../lib/places-view';

// Reads the session, so it cannot be prerendered.
export const prerender = false;

const user = Astro.locals.user;
const place = await getBySlug(Astro.params.slug!, user);

// `getBySlug` already answers `null` for a private entry the visitor cannot
// see, so a missing one and a forbidden one render the same page — nothing
// here can confirm which slugs are real.
if (!place) {
  Astro.response.status = 404;
}

const badges = place ? typeBadges(place) : [];
const facts = place ? factsFor(place) : [];
const coordinates = place ? formatCoordinates(place.lat, place.lng) : null;
const note = place ? extentNote(place) : null;

// Both sets of extras, labelled by which half of a hybrid they belong to.
const extras = place
  ? [
      ...Object.entries(place.location?.attributes ?? {}).map(
        ([key, value]) => ({ key, value }),
      ),
      ...Object.entries(place.activity?.attributes ?? {}).map(
        ([key, value]) => ({ key, value }),
      ),
    ]
  : [];

const formatVisit = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

{place ? (
  <Layout
    title={place.name}
    description={place.description ?? `${place.name} — a place worth knowing.`}
    image={place.photoUrl ?? undefined}
  >
    <div class="mx-auto max-w-2xl px-4 py-12">
      <a
        href="/places"
        class="text-sm text-stone-500 transition-colors hover:text-emerald-700"
      >
        &larr; All places &amp; activities
      </a>

      <div class="mt-4 flex items-start justify-between gap-4">
        <h1 class="text-3xl font-bold text-stone-900">{place.name}</h1>

        {place.isOwn && place.visibility === 'private' && (
          <span class="mt-1 shrink-0 rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-600">
            Private
          </span>
        )}
      </div>

      <p class="mt-3 flex flex-wrap items-center gap-2">
        {badges.map((type) => (
          <span
            class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium text-white"
            style={`background-color: ${type.colour ?? '#57534e'}`}
          >
            {type.icon && <span aria-hidden="true">{type.icon}</span>}
            {type.label}
          </span>
        ))}
        {!place.isOwn && (
          <span class="text-xs text-stone-500">by {place.ownerName}</span>
        )}
      </p>

      {place.description && (
        <p class="mt-6 whitespace-pre-line text-stone-700">{place.description}</p>
      )}

      {facts.length > 0 && (
        <dl class="mt-8 grid grid-cols-2 gap-4 rounded-xl border border-stone-200 bg-white p-5 sm:grid-cols-3">
          {facts.map((fact) => (
            <div>
              <dt class="text-xs uppercase tracking-wide text-stone-400">
                {fact.label}
              </dt>
              <dd class="mt-1 text-sm font-medium text-stone-800">
                {fact.value}
              </dd>
            </div>
          ))}
        </dl>
      )}

      {(coordinates || place.location?.access) && (
        <section class="mt-8">
          <h2 class="text-lg font-semibold text-stone-900">Getting there</h2>

          {coordinates && (
            <p class="mt-2 text-sm text-stone-600">
              <a
                href={`https://www.openstreetmap.org/?mlat=${place.lat}&mlon=${place.lng}#map=14/${place.lat}/${place.lng}`}
                rel="noopener noreferrer"
                target="_blank"
                class="font-mono text-emerald-700 hover:underline"
              >
                {coordinates}
              </a>
              {note && <span class="ml-2 text-stone-500">— {note}</span>}
            </p>
          )}

          {place.location?.access && (
            <p class="mt-2 text-sm text-stone-600">{place.location.access}</p>
          )}
        </section>
      )}

      {place.photos.length > 0 && (
        <section class="mt-8">
          <h2 class="text-lg font-semibold text-stone-900">Photos</h2>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {place.photos.map((photo) => (
              <figure>
                <img
                  src={photo.url}
                  alt={photo.caption ?? ''}
                  loading="lazy"
                  class="w-full rounded-xl border border-stone-200 object-cover"
                />
                {photo.caption && (
                  <figcaption class="mt-1 text-xs text-stone-500">
                    {photo.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </section>
      )}

      {place.links.length > 0 && (
        <section class="mt-8">
          <h2 class="text-lg font-semibold text-stone-900">Nearby and related</h2>
          <ul class="mt-3 divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white">
            {place.links.map((link) => (
              <li class="flex items-center justify-between gap-4 px-5 py-3">
                <span class="text-xs uppercase tracking-wide text-stone-400">
                  {link.label}
                </span>
                <a
                  href={`/places/${link.other.slug}`}
                  class="text-sm font-medium text-emerald-700 hover:underline"
                >
                  {link.other.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {place.visits.length > 0 && (
        <section class="mt-8">
          <h2 class="text-lg font-semibold text-stone-900">Been there</h2>
          <ul class="mt-3 space-y-2">
            {place.visits.map((visit) => (
              <li class="text-sm text-stone-600">
                <span class="font-medium text-stone-800">
                  {formatVisit(visit.visitedOn)}
                </span>
                <span class="text-stone-500"> — {visit.userName}</span>
                {visit.note && <span class="text-stone-500">, {visit.note}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {extras.length > 0 && (
        <section class="mt-8">
          <h2 class="text-lg font-semibold text-stone-900">Anything else</h2>
          <dl class="mt-3 divide-y divide-stone-200 rounded-xl border border-stone-200 bg-white">
            {extras.map((extra) => (
              <div class="flex items-baseline justify-between gap-4 px-5 py-3">
                <dt class="text-sm text-stone-500">{extra.key}</dt>
                <dd class="text-sm font-medium text-stone-800">{extra.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}
    </div>
  </Layout>
) : (
  <Layout title="Place not found">
    <div class="mx-auto max-w-2xl px-4 py-20 text-center">
      <h1 class="text-3xl font-bold text-stone-900">Place not found</h1>
      <p class="mt-3 text-stone-600">
        It may have been deleted, or it may be private.
      </p>
      <a
        href="/places"
        class="mt-8 inline-block rounded-lg border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-100"
      >
        All places &amp; activities
      </a>
    </div>
  </Layout>
)}
